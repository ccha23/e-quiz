FROM alpine:3.23.4

# Add tools
RUN apk add --no-cache wget git curl bash patch zip unzip rsync php83-cli php83-phar php83-openssl php83-mbstring php83-ctype php83-tokenizer php83-fileinfo

# Install Composer (PHP dependency manager)
RUN ln -sf /usr/bin/php83 /usr/bin/php && \
    curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Fix permission
RUN /bin/sh -c set -eux; adduser -u 82 -D -S -G www-data www-data && \
    mkdir -p /var/www/html /output && \
    chown -R www-data:www-data /var/www/html /output

USER www-data
WORKDIR /var/www/html

# Get moodle
COPY --chmod=755 bin/get_moodle.sh /usr/local/sbin/
RUN get_moodle.sh

# Install Composer dependencies (vendor/) so the Moodle Router (r.php / Slim)
# can initialize. Without this, environment checks report:
#   - "Composer installed data not found"
#   - "Router not configured"
# Platform requirements are ignored because the build image (html-docker) only has
# a minimal PHP CLI; the runtime phpfpm image has all required extensions.
RUN composer install --no-dev --classmap-authoritative --no-interaction --ignore-platform-reqs

# Get moodle plugins
{%- with p = plugins %}
{%- if p['forcedcache']['enabled'] %}
COPY --chmod=755 bin/get_forcedcache.sh /usr/local/sbin/
RUN get_forcedcache.sh
{%- endif %}
{%- if p['coderunner']['enabled'] %}
COPY --chmod=755 bin/get_coderunner.sh /usr/local/sbin/
RUN get_coderunner.sh
{%- endif %}
{%- if p['stack']['enabled'] %}
COPY --chmod=755 bin/get_stack.sh /usr/local/sbin/
RUN get_stack.sh
{%- endif %}
{%- endwith %}

# Fix issues
COPY --chmod=755 bin/patch_moodle.sh /usr/local/sbin/
RUN patch_moodle.sh

# To prevent repeated initialization
# See run.sh
RUN touch .initialized

USER root

COPY --chmod=755 bin/run.sh /usr/local/sbin/

CMD ["run.sh"]